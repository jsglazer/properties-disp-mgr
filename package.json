{
	"name": "properties-disp-mgr",
	"version": "1.0.1",
	"description": "Collapse the Obsidian properties panel on open, scoped by folder, regex, or a per-note frontmatter key.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
		"lint": "eslint src",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"properties",
		"frontmatter",
		"fold"
	],
	"author": "Josh Glazer",
	"license": "MIT",
	"dependencies": {
		"monkey-around": "^3.0.0"
	},
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@types/node": "^26.6.5",
		"esbuild": "0.28.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "1.8.7",
		"prettier": "^3.9.10",
		"tslib": "2.8.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.61.0",
		"vitest": "^5.0.4"
	},
	"overrides": {
		"@microsoft/eslint-plugin-sdl": {
			"eslint": "$eslint"
		},
		"eslint-plugin-import": {
			"eslint": "$eslint"
		},
		"eslint-plugin-react": {
			"eslint": "$eslint"
		}
	}
}
