{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2018",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"isolatedModules": true,
		"strict": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"lib": ["ES2018", "DOM"],
		"types": ["node"],
		"moduleResolution": "bundler"
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
